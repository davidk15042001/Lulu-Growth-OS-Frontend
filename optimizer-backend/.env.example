PORT=4100
FRONTEND_ORIGIN=http://localhost:5173
STORE_PATH=.data/store.sqlite
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
AUTH_JWT_SECRET=local-dev-auth-secret-change-me-32
AUTH_TOKEN_TTL_MINUTES=720
DATAFORSEO_TIMEOUT_MS=15000
# Demo workspace bootstrap:
# workspaceId=demo-workspace | second-workspace
# email=admin@demo.example | editor@demo.example | viewer@demo.example | owner@second.example
# password=DemoAdmin!2026 | DemoEditor!2026 | DemoViewer!2026 | SecondAdmin!2026

# Set to false and provide live credentials to use the real API.
DATAFORSEO_MOCK_MODE=true
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Legacy fallbacks only. Active market packs now send per-country and per-language requests.
DATAFORSEO_PRIMARY_LANGUAGE=English
DATAFORSEO_PRIMARY_LOCATION=United States
